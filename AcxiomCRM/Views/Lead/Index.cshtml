@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Leads</h2>
    <a class="btn btn-primary" asp-action="Create">Add Lead</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Status</th>
                <th>Priority</th>
                <th>Expected Value</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var lead in Model)
            {
                <tr>
                    <td>@lead.LeadName</td>
                    <td>@lead.CompanyName</td>
                    <td>@lead.Status</td>
                    <td>@lead.Priority</td>
                    <td>@lead.ExpectedValue.ToString("C")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@lead.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@lead.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this lead?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
