@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Edit Lead";
    var leadStatuses = AcxiomCRM.Services.CrmWorkflowRules.LeadStatuses;
    var owners = ViewBag.AssignableOwners as IEnumerable<AcxiomCRM.Data.ApplicationUser> ?? Enumerable.Empty<AcxiomCRM.Data.ApplicationUser>();
}

<h2>Edit Lead</h2>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="LeadName" class="form-label"></label>
            <input asp-for="LeadName" class="form-control" />
            <span asp-validation-for="LeadName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CompanyName" class="form-label"></label>
            <input asp-for="CompanyName" class="form-control" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Source" class="form-label"></label>
            <input asp-for="Source" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                @foreach (var status in leadStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Priority" class="form-label"></label>
            <select asp-for="Priority" class="form-select">
                @foreach (var priority in AcxiomCRM.Services.CrmWorkflowRules.LeadPriorities)
                {
                    <option value="@priority">@priority</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="ExpectedValue" class="form-label"></label>
            <input asp-for="ExpectedValue" class="form-control" />
            <span asp-validation-for="ExpectedValue" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="col-md-6">
                <label asp-for="AssignedToId" class="form-label">Assigned Sales Executive</label>
                <select asp-for="AssignedToId" class="form-select">
                    <option value="">Select an active Sales Executive</option>
                    @foreach (var owner in owners)
                    {
                        <option value="@owner.Id">@owner.FullName (@owner.Email)</option>
                    }
                </select>
                <span asp-validation-for="AssignedToId" class="text-danger"></span>
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
