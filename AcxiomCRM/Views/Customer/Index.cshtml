@model IEnumerable<AcxiomCRM.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Customers</h2>
    <a class="btn btn-primary" asp-action="Create">Add Customer</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="search" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search by name, email, phone or company" />
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="col-md-3">
            <select name="ownerId" class="form-select">
                <option value="">All owners</option>
                @foreach (var owner in (IEnumerable<AcxiomCRM.Data.ApplicationUser>)ViewBag.AssignableOwners)
                {
                    <option value="@owner.Id" selected="@(ViewBag.OwnerId as string == owner.Id)">@owner.FullName</option>
                }
            </select>
        </div>
    }
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Company</th>
                <th>Assigned To</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.CustomerName</td>
                    <td>@customer.Email</td>
                    <td>@customer.Phone</td>
                    <td>@customer.CompanyName</td>
                    <td>@(customer.OwnerId != null && ((IDictionary<string, string>)ViewBag.OwnerNames).TryGetValue(customer.OwnerId, out var ownerName) ? ownerName : "Unassigned")</td>
                    <td>@customer.Status</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@customer.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@customer.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this customer?');">Deactivate</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
