@model IEnumerable<AcxiomCRM.Models.AuditLogRowViewModel>

@{
    ViewData["Title"] = "Audit Log";
    var isAdmin = (bool)ViewBag.IsAdmin;
}

<h2>Audit Log</h2>
@if (!isAdmin)
{
    <p class="text-muted">Only your own business-activity events are shown. Sensitive values and network details are hidden.</p>
}
<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search events" /></div>
    <div class="col-md-2">
        <select class="form-select" name="entityName">
            <option value="">All entities</option>
            @foreach (var name in new[] { "Customer", "Lead", "FollowUp", "Opportunity", "Activity", "User", "Authentication" })
            {
                <option value="@name" selected="@(ViewBag.EntityName as string == name)">@name</option>
            }
        </select>
    </div>
    @if (isAdmin)
    {
        <div class="col-md-2">
            <select class="form-select" name="actorUserId" aria-label="Filter by user">
                <option value="">All users</option>
                @foreach (var user in (IEnumerable<AcxiomCRM.Controllers.AssigneeOptionViewModel>)ViewBag.Users)
                {
                    <option value="@user.Id" selected="@(ViewBag.UserId as string == user.Id)">@user.Name</option>
                }
            </select>
        </div>
    }
    <div class="col-md-2">
        <select class="form-select" name="action">
            <option value="">All actions</option>
            @foreach (var name in new[] { "Login", "Logout", "FailedLogin", "Lockout", "Register", "Create", "Update", "Delete", "Deactivate", "Convert", "Complete", "Reschedule", "CreateUser", "ChangeUserRole", "ActivateUser", "DeactivateUser", "UnlockUser" })
            {
                <option value="@name" selected="@(ViewBag.ActionFilter as string == name)">@name</option>
            }
        </select>
    </div>
    <div class="col-md-2"><input class="form-control" type="date" name="from" value="@ViewBag.From" /></div>
    <div class="col-md-2"><input class="form-control" type="date" name="to" value="@ViewBag.To" /></div>
    <div class="col-md-1"><button class="btn btn-outline-primary w-100" type="submit">Filter</button></div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr><th>Date</th><th>User</th><th>Entity</th><th>Action</th><th>Record</th>@if (isAdmin) { <th>Old value</th><th>New value</th><th>IP address</th> }</tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CreatedDate.ToString("g")</td><td>@(item.UserName ?? "-")</td><td>@item.EntityName</td><td>@item.Action</td><td>@(item.RecordId ?? "-")</td>
                @if (isAdmin) { <td>@(item.OldValue ?? "-")</td><td>@(item.NewValue ?? "-")</td><td>@(item.IpAddress ?? "-")</td> }
            </tr>
        }
        </tbody>
    </table>
</div>
