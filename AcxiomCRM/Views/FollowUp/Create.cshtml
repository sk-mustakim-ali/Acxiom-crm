@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Create Follow-Up";
}

<h2>Schedule Follow-Up</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Subject" class="form-label"></label>
            <input asp-for="Subject" class="form-control" />
            <span asp-validation-for="Subject" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FollowUpType" class="form-label"></label>
            <input asp-for="FollowUpType" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="FollowUpDate" class="form-label"></label>
            <input asp-for="FollowUpDate" class="form-control" type="date" />
            <span asp-validation-for="FollowUpDate" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <input asp-for="Status" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="CustomerId" class="form-label"></label>
            <input asp-for="CustomerId" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control"></textarea>
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
