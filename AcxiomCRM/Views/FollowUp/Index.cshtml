@model IEnumerable<AcxiomCRM.Models.FollowUp>

@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Follow-Ups</h2>
    <a class="btn btn-primary" asp-action="Create">Schedule Follow-Up</a>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn btn-sm @(ViewBag.Due == null ? "btn-primary" : "btn-outline-primary")">All</a>
    <a asp-action="Index" asp-route-due="upcoming" class="btn btn-sm @(ViewBag.Due as string == "upcoming" ? "btn-primary" : "btn-outline-primary")">Upcoming (@ViewBag.UpcomingCount)</a>
    <a asp-action="Index" asp-route-due="overdue" class="btn btn-sm @(ViewBag.Due as string == "overdue" ? "btn-danger" : "btn-outline-danger")">Overdue (@ViewBag.OverdueCount)</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="search" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search subject or related record" />
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var status in AcxiomCRM.Services.CrmWorkflowRules.FollowUpStatuses)
            {
                <option value="@status" selected="@(Context.Request.Query["status"] == status)">@status</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" name="date" value="@Context.Request.Query["date"]" class="form-control" />
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select">
                <option value="">All assignees</option>
                @foreach (var assignee in (IEnumerable<AcxiomCRM.Data.ApplicationUser>)ViewBag.Assignees)
                {
                    <option value="@assignee.Id" selected="@(ViewBag.AssignedTo as string == assignee.Id)">@assignee.FullName</option>
                }
            </select>
        </div>
    }
    <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100">Filter</button></div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Subject</th>
            <th>Date</th>
            <th>Type</th>
            <th>Status</th>
            <th>Related record</th>
            <th>Assigned To</th>
            <th>Notes</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var followUp in Model)
        {
            <tr>
                <td>@followUp.Subject</td>
                <td>
                    @followUp.FollowUpDate.ToShortDateString()
                    @if (AcxiomCRM.Services.CrmWorkflowRules.IsOverdueFollowUp(followUp, DateTime.Today))
                    {
                        <span class="badge bg-danger">Overdue</span>
                    }
                </td>
                <td>@followUp.FollowUpType</td>
                <td>@followUp.Status</td>
                <td>@(followUp.Customer?.CustomerName ?? followUp.Lead?.LeadName ?? followUp.Opportunity?.OpportunityName ?? "-")</td>
                <td>@(followUp.AssignedToId != null && ((IDictionary<string, string>)ViewBag.AssigneeNames).TryGetValue(followUp.AssignedToId, out var assigneeName) ? assigneeName : "Unassigned")</td>
                <td>@followUp.Notes</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@followUp.Id">Edit / Update Status</a>
                    <form asp-action="Delete" asp-route-id="@followUp.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this follow-up?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
