@model IEnumerable<AcxiomCRM.Models.Opportunity>

@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Opportunities</h2>
    <a class="btn btn-primary" asp-action="Create">Add Opportunity</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Customer</th>
                <th>Stage</th>
                <th>Amount</th>
                <th>Probability</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var opportunity in Model)
            {
                <tr>
                    <td>@opportunity.OpportunityName</td>
                    <td>@(opportunity.Customer?.CustomerName ?? "-")</td>
                    <td>@opportunity.Stage</td>
                    <td>@opportunity.Amount.ToString("C")</td>
                    <td>@opportunity.Probability%</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@opportunity.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@opportunity.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this opportunity?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
