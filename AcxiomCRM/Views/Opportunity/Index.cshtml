@model IEnumerable<AcxiomCRM.Models.Opportunity>

@{
    ViewData["Title"] = "Opportunities";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Opportunities</h2>
    <a class="btn btn-primary" asp-action="Create">Add Opportunity</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="search" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Search opportunity or customer" />
    </div>
    <div class="col-md-2">
        <select name="stage" class="form-select">
            <option value="">All stages</option>
            @foreach (var stage in AcxiomCRM.Services.CrmWorkflowRules.OpportunityStages)
            {
                <option value="@stage" selected="@(Context.Request.Query["stage"] == stage)">@stage</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var status in AcxiomCRM.Services.CrmWorkflowRules.OpportunityStatuses)
            {
                <option value="@status" selected="@(Context.Request.Query["status"] == status)">@status</option>
            }
        </select>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
    {
        <div class="col-md-2">
            <select name="ownerId" class="form-select">
                <option value="">All owners</option>
                @foreach (var owner in (IEnumerable<AcxiomCRM.Data.ApplicationUser>)ViewBag.AssignableOwners)
                {
                    <option value="@owner.Id" selected="@(ViewBag.OwnerId as string == owner.Id)">@owner.FullName</option>
                }
            </select>
        </div>
    }
    <div class="col-md-2">
        <select name="source" class="form-select">
            <option value="">All sources</option>
            @foreach (var source in (IEnumerable<string>)ViewBag.Sources)
            {
                <option value="@source" selected="@(ViewBag.Source as string == source)">@source</option>
            }
        </select>
    </div>
    <div class="col-md-1"><button type="submit" class="btn btn-outline-primary w-100">Go</button></div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Customer</th>
                <th>Stage</th>
                <th>Amount</th>
                <th>Probability</th>
                <th>Source</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var opportunity in Model)
            {
                <tr>
                    <td>@opportunity.OpportunityName</td>
                    <td>@(opportunity.Customer?.CustomerName ?? "-")</td>
                    <td>@opportunity.Stage</td>
                    <td>@opportunity.Amount.ToString("C")</td>
                    <td>@opportunity.Probability%</td>
                    <td>@opportunity.Source</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@opportunity.Id">Details</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@opportunity.Id">Edit</a>
                        <form asp-action="Delete" asp-route-id="@opportunity.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this opportunity?');">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
