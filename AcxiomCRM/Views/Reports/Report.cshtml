@model AcxiomCRM.Models.ReportPageViewModel
@{ ViewData["Title"] = Model.Title; }
<h2>@Model.Title</h2>
<p class="text-muted">@Model.Description</p>
@if (Model.Title == "User Activity Report")
{
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3"><label class="form-label">From</label><input class="form-control" type="date" name="from" value="@ViewBag.From" /></div>
        <div class="col-md-3"><label class="form-label">To</label><input class="form-control" type="date" name="to" value="@ViewBag.To" /></div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <div class="col-md-4"><label class="form-label">Assignee</label><select class="form-select" name="assignee"><option value="">All users</option>@foreach (var user in (IEnumerable<AcxiomCRM.Controllers.AssigneeOptionViewModel>)ViewBag.Users) { <option value="@user.Id" selected="@(ViewBag.Assignee as string == user.Id)">@user.Name</option> }</select></div>
        }
        <div class="col-md-2 align-self-end"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </form>
}
@if (Model.Title == "Audit Report")
{
    <form method="get" class="row g-2 mb-3">
        <div class="col-md-3"><label class="form-label">From</label><input class="form-control" type="date" name="from" value="@ViewBag.From" /></div>
        <div class="col-md-3"><label class="form-label">To</label><input class="form-control" type="date" name="to" value="@ViewBag.To" /></div>
        <div class="col-md-2"><label class="form-label">Entity</label><select class="form-select" name="entityName"><option value="">All</option>@foreach (var val in new[] { "Customer", "Lead", "FollowUp", "Opportunity", "Activity", "User", "Authentication" }) { <option value="@val" selected="@(ViewBag.EntityName as string == val)">@val</option> }</select></div>
        <div class="col-md-2"><label class="form-label">Action</label><select class="form-select" name="action"><option value="">All</option>@foreach (var val in new[] { "Login", "Logout", "FailedLogin", "Lockout", "Create", "Update", "Delete", "Deactivate", "Convert", "Complete", "Reschedule", "Register", "CreateUser", "ChangeUserRole", "ActivateUser", "DeactivateUser", "UnlockUser" }) { <option value="@val" selected="@(ViewBag.ActionFilter as string == val)">@val</option> }</select></div>
        @if (User.IsInRole("Admin"))
        {
            <div class="col-md-2"><label class="form-label">Actor</label><select class="form-select" name="actorUserId"><option value="">All users</option>@foreach (var user in (IEnumerable<AcxiomCRM.Controllers.AssigneeOptionViewModel>)ViewBag.Users) { <option value="@user.Id" selected="@(ViewBag.UserId as string == user.Id)">@user.Name</option> }</select></div>
        }
        <div class="col-md-2 align-self-end"><button class="btn btn-outline-primary w-100">Filter</button></div>
    </form>
}
@if (Model.Metrics.Count > 0)
{
    <div class="row mb-3">@foreach (var metric in Model.Metrics) { <div class="col-md-3"><div class="card mb-2"><div class="card-body"><div class="text-muted">@metric.Label</div><strong>@metric.Value</strong></div></div></div> }</div>
}
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="table-dark"><tr>@foreach (var column in Model.Columns) { <th>@column</th> }</tr></thead>
        <tbody>@foreach (var row in Model.Rows) { <tr>@foreach (var cell in row) { <td>@cell</td> }</tr> }</tbody>
    </table>
</div>
